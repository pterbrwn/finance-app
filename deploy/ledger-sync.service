[Unit]
Description=Update Ledger bank data locally
Requires=ledger.service
After=ledger.service

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/ledger/current
ExecStart=%h/.local/share/ledger/current/scripts/start-sync.sh
Environment=PORT=3001
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=Ledger private finance dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ledger/current
ExecStart=%h/.local/share/ledger/current/scripts/start-ledger.sh
Environment=PORT=3001
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

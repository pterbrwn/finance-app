{
  "name": "ledger-personal-finance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "bash scripts/start-ledger.sh",
    "setup:local": "bash scripts/run-node.sh scripts/setup-local.mjs",
    "dev": "bash scripts/start-ledger.sh",
    "check:local-http": "npm run build && bash scripts/run-node.sh scripts/check-dev.mjs --http",
    "build": "bash scripts/build.sh",
    "validate": "bash scripts/run-node.sh scripts/validate-artifact.mjs",
    "check:source": "bash scripts/run-node.sh scripts/check-source.mjs",
    "check:sqlite": "bash scripts/run-node.sh scripts/check-sqlite.mjs",
    "check:backup": "bash scripts/run-node.sh scripts/check-backup.mjs",
    "check:browser": "bash scripts/run-node.sh scripts/check-browser.mjs",
    "check:browser:case": "bash scripts/run-node.sh scripts/check-browser.mjs",
    "check:browser:harness": "bash scripts/run-node.sh scripts/check-browser-harness.mjs",
    "check:budget": "bash scripts/run-node.sh scripts/check-budget.mjs",
    "check:statement-reconciliation": "bash scripts/run-node.sh scripts/check-statement-reconciliation.mjs",
    "check:portable-export": "bash scripts/run-node.sh scripts/check-portable-export.mjs",
    "check:encrypted-backup": "bash scripts/run-node.sh scripts/check-encrypted-backup.mjs",
    "check:transaction-splits": "bash scripts/run-node.sh scripts/check-transaction-splits.mjs",
    "check:commitments": "bash scripts/run-node.sh scripts/check-commitments.mjs",
    "measure:performance": "bash scripts/run-node.sh scripts/measure-performance.mjs",
    "import:legacy": "bash scripts/run-node.sh scripts/import-legacy-json.mjs",
    "check": "npm run test:ci",
    "check:runtime": "bash scripts/run-node.sh scripts/check-runtime-status.mjs",
    "test:fast": "bash scripts/run-node.sh scripts/run-test-profile.mjs fast",
    "test:integration": "bash scripts/run-node.sh scripts/run-test-profile.mjs integration",
    "test:browser": "bash scripts/run-node.sh scripts/run-test-profile.mjs browser",
    "test:recovery": "bash scripts/run-node.sh scripts/run-test-profile.mjs recovery",
    "test:release": "bash scripts/run-node.sh scripts/run-test-profile.mjs release",
    "test:extended": "bash scripts/run-node.sh scripts/run-test-profile.mjs extended",
    "test:ci": "npm run test:fast && npm run test:integration && npm run test:recovery && npm run test:browser && npm run test:release"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}

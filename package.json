{
  "name": "ledger-personal-finance",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "prestart": "npm run build",
    "start": "node scripts/dev-server.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "predev": "npm run build",
    "dev": "node scripts/dev-server.mjs",
    "check:local-http": "npm run build && node scripts/check-dev.mjs --http",
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check": "npm run build && npm run validate && node scripts/check-finance.mjs && node scripts/check-dev.mjs"
  }
}

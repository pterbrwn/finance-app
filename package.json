{
  "name": "ledger-personal-finance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "bash scripts/start-ledger.sh",
    "setup:local": "bash scripts/run-node.sh scripts/setup-local.mjs",
    "dev": "bash scripts/start-ledger.sh",
    "check:local-http": "npm run build && bash scripts/run-node.sh scripts/check-dev.mjs --http",
    "build": "bash scripts/build.sh",
    "validate": "bash scripts/run-node.sh scripts/validate-artifact.mjs",
    "check:source": "bash scripts/run-node.sh scripts/check-source.mjs",
    "check:sqlite": "bash scripts/run-node.sh scripts/check-sqlite.mjs",
    "check:backup": "bash scripts/run-node.sh scripts/check-backup.mjs",
    "check:browser": "bash scripts/run-node.sh scripts/check-browser.mjs",
    "check:budget": "bash scripts/run-node.sh scripts/check-budget.mjs",
    "measure:performance": "bash scripts/run-node.sh scripts/measure-performance.mjs",
    "import:legacy": "bash scripts/run-node.sh scripts/import-legacy-json.mjs",
    "check": "npm run build && npm run validate && bash scripts/run-node.sh scripts/check-finance.mjs && npm run check:budget && bash scripts/run-node.sh scripts/check-dev.mjs && npm run check:sqlite && npm run check:backup && npm run check:runtime",
    "check:runtime": "bash scripts/run-node.sh scripts/check-runtime-status.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
